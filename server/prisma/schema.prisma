// Kelly's Deli — data model. See docs/SPEC.md + docs/SPEC-v2.md.
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is the AWS Lambda runtime Vercel uses.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  // Operative meaning: max catering orders per DAY at this location (see SPEC decision #2).
  weeklyCapacity Int      @default(5)
  active         Boolean  @default(true)
  orders         Order[]
  createdAt      DateTime @default(now())
}

model Platter {
  id                String      @id @default(cuid())
  category          String      @default("home") // home | events | seasonal | platters
  name              String
  description       String
  pricePerHead      Decimal?    @db.Decimal(10, 2) // null for fixed-price platters
  fixedPrice        Decimal?    @db.Decimal(10, 2) // null for per-head platters
  cost              Decimal     @db.Decimal(10, 2) // owner's cost to produce one unit / per head — drives margin
  serves            String? // display only, e.g. "15-20"
  minHeadcount      Int         @default(1)
  items             Json // ordered array of { label: string, qtyPerUnit: number }
  imageUrl          String?
  active            Boolean     @default(true)
  sortOrder         Int         @default(0)
  // Board configurator (category = "platters" only). Null for regular catering platters.
  boardType         String? // charcuterie | savoury | cheese | salmon
  size              String? // small | medium | large
  // v2 board catalogue (category = "board"). Two-tier: signature (fast path) | gallery ("more boards").
  tier              String? // signature | gallery
  // Numeric feeds range for the event recommender's midpoint maths (serves = display string).
  feedsMin          Int?
  feedsMax          Int?
  // "Plan My Event" recommender config (admin-managed per board).
  recommendEligible Boolean     @default(false)
  recommendPriority Int         @default(0) // higher = recommended first
  orders            Order[]
  orderItems        OrderItem[]
  categories        PlatterCategory[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([category])
  @@index([boardType])
  @@index([tier])
}

// Occasion-based storefront categories (Hosting, At Home, Office & Corporate, …).
// Fully admin-managed: the owner adds/renames categories and assigns boards. This is
// ORTHOGONAL to Platter.category (a type classifier: home|board|platters…). It drives
// the browse-by-occasion storefront and each category's SEO landing page.
model Category {
  id             String            @id @default(cuid())
  slug           String            @unique // URL + SEO, e.g. "hosting", "at-home", "office-corporate"
  name           String // "Hosting"
  tagline        String? // short hero subtitle
  description    String? // intro copy on the landing page
  heroImageUrl   String?
  // SEO — each category is a search landing page ("office catering solihull" etc.).
  seoTitle       String?
  seoDescription String?
  // Corporate categories surface the enquiry path + monthly-invoicing subscription copy.
  isCorporate    Boolean           @default(false)
  // Promote the "Plan My Event" recommender alongside the boards (Hosting).
  promotePlanner Boolean           @default(false)
  active         Boolean           @default(true)
  sortOrder      Int               @default(0)
  platters       PlatterCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([active, sortOrder])
}

// Board ↔ category assignment (many-to-many): a board can appear in several occasions.
model PlatterCategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  platterId  String
  platter    Platter  @relation(fields: [platterId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([categoryId, platterId])
  @@index([platterId])
}

// Subscribe & Save recurring plan. Payment-READY, not payment-LIVE: created when a
// customer opts into a recurring board so the owner sees the intent and sets the schedule
// up manually. Fields map cleanly onto Stripe Billing for when Stripe lands.
model Subscription {
  id                   String   @id @default(cuid())
  // pending = awaiting owner setup; active|paused|cancelled mirror Stripe sub statuses.
  status               String   @default("pending")
  frequency            String // weekly | fortnightly | monthly  (-> Stripe price interval)
  discountPct          Int      @default(10)
  customerName         String
  email                String
  phone                String
  // Corporate subscriptions are invoiced monthly rather than card-billed up front.
  invoiced             Boolean  @default(false)
  notes                String?
  // Stripe Billing mapping — nullable until Stripe lands.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  orders               Order[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

// Corporate / office enquiry — lands in admin. Company, headcount, frequency so the
// owner can follow up and confirm a standing-order schedule.
model CorporateEnquiry {
  id          String   @id @default(cuid())
  company     String
  contactName String
  email       String
  phone       String?
  headcount   Int?
  frequency   String? // one-off | weekly | fortnightly | monthly
  message     String?
  status      String   @default("new") // new | contacted | closed
  createdAt   DateTime @default(now())

  @@index([status])
}

// "Never miss it" — capture an email to remind the customer before an occasion
// (Mother's Day, Christmas, a birthday). Lands in admin; the owner nudges nearer the time.
model ReminderSignup {
  id           String    @id @default(cuid())
  email        String
  occasion     String // "Mother's Day" | "Christmas" | "Birthday" | free text
  reminderDate DateTime? @db.Date // optional specific date to prompt before
  notified     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([occasion])
}

// Curated "one-tap" combos (board(s) + add-ons) that fill the basket in a single click.
// Priced honestly at the real total of the components (no fake discounts) — the win is
// convenience + a complete spread. Fully admin-managed. Items reference real Platter/AddOn
// rows by id + kind (a light join so a bundle survives an item being renamed).
model Bundle {
  id          String       @id @default(cuid())
  name        String
  tagline     String? // one-line pitch shown on the card
  description String?
  imageUrl    String?
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  items       BundleItem[]
  createdAt   DateTime     @default(now())

  @@index([active, sortOrder])
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  bundle    Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  kind      String // "board" | "addon"
  refId     String // Platter.id (board) or AddOn.id
  quantity  Int    @default(1)
  sortOrder Int    @default(0)

  @@index([bundleId])
}

// "Send a gift voucher" request. Payment isn't taken online yet (no Stripe), so this lands
// in admin like a corporate enquiry — the owner arranges payment and issues the voucher.
// Upgrades cleanly to self-serve stored-value gift cards when Stripe lands.
model GiftVoucherRequest {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(10, 2)
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  recipientName String?
  message       String? // note to print with the voucher
  status        String   @default("new") // new | contacted | fulfilled | closed
  createdAt     DateTime @default(now())

  @@index([status])
}

// Optional extras attached to any order (cutlery, plates, drinks, setup, sweet boards...).
// Fully admin-managed. See build spec §3.
model AddOn {
  id                   String       @id @default(cuid())
  name                 String
  description          String? // carries the "[CHECK PRICE]" seed note; owner edits in admin
  price                Decimal      @db.Decimal(10, 2)
  unitType             String       @default("per_order") // per_person | per_order | serves
  unitLabel            String? // display, e.g. "per person", "serves 10", "per bottle"
  servesPerUnit        Int? // for unitType "serves" (e.g. napkins pack serves 10)
  suggestFromHeadcount Boolean      @default(false) // pre-fill suggested qty from headcount/feeds
  imageUrl             String?
  active               Boolean      @default(true)
  sortOrder            Int          @default(0)
  orderAddOns          OrderAddOn[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([active, sortOrder])
}

// Admin-managed ingredient picker for the "build your own" charcuterie board.
model BoardComponent {
  id        String   @id @default(cuid())
  category  String // cheese | meat | savoury | cracker | jam (= BoardComponentGroup.key)
  label     String
  imageUrl  String?
  // Charged when the selection exceeds the group's includedFree allowance (cheapest picks are free).
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isDefault Boolean  @default(false) // pre-selected in the customer configurator
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Per-group configurator rules (headings, selection limits, free allowance).
// Fixed set of five rows keyed by BoardComponent.category — admin edits rules, never creates groups.
model BoardComponentGroup {
  id            String   @id @default(cuid())
  key           String   @unique // cheese | meat | savoury | cracker | jam
  heading       String // customer-facing section heading
  maxSelections Int? // null = unlimited
  includedFree  Int      @default(0) // this many selections are free; beyond that, option prices apply
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  name         String
  description  String
  pricePerHead Decimal  @db.Decimal(10, 2)
  cost         Decimal  @default(0) @db.Decimal(10, 2)
  capacity     Int      @default(12) // max guests per session = one (location, date)
  imageUrl     String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                       String       @id @default(cuid())
  ref                      String       @unique // e.g. KD-7F3K9Q
  type                     String       @default("platter") // platter | gift | experience
  platterId                String?
  platter                  Platter?     @relation(fields: [platterId], references: [id])
  experienceId             String?
  experience               Experience?  @relation(fields: [experienceId], references: [id])
  headcount                Int
  // Board configurator only: quantity of boards ordered (fixedPrice x quantity) and,
  // for "build your own", the customer's chosen BoardComponent labels (overrides platter.items
  // for prep-sheet purposes). Null for regular catering platters/experiences.
  quantity                 Int?
  customItems              Json?
  // v2 line-item order: full itemisation of boards + add-ons. platterId above is the
  // primary/first board (kept for back-compat with prep-sheet/stats/serialize).
  items                    OrderItem[]
  addOns                   OrderAddOn[]
  // Event-planner occasion, for future marketing segmentation.
  occasion                 String? // Birthday | Corporate | Family gathering | Other
  total                    Decimal      @db.Decimal(10, 2)
  deposit                  Decimal      @db.Decimal(10, 2)
  depositStatus            String       @default("pending") // pending | paid | refunded
  // Deposit payment plumbing — a future Stripe webhook flips depositStatus -> paid and
  // stamps depositPaidAt. depositIntentId stores the provider's payment-intent id.
  depositIntentId          String?
  depositPaidAt            DateTime?
  // Subscribe & Save recurring intent (payment-ready, not payment-live). The first order
  // carries a snapshot of the recurring terms; subscription links the ongoing plan.
  isSubscription           Boolean      @default(false)
  subscriptionFrequency    String? // weekly | fortnightly | monthly
  subscriptionDiscount     Decimal?     @db.Decimal(10, 2)
  subscriptionId           String?
  subscription             Subscription? @relation(fields: [subscriptionId], references: [id])
  // gift delivery
  isGift                   Boolean      @default(false)
  recipientName            String?
  deliveryAddress          String?
  giftMessage              String?
  collectionOrDeliveryDate DateTime     @db.Date
  locationId               String
  location                 Location     @relation(fields: [locationId], references: [id])
  customerName             String
  phone                    String
  email                    String
  notes                    String?
  freebie                  String? // first-order hook note, e.g. "FREE: box of sausage rolls"
  // v2 manual staff flow: new -> deposit_requested -> confirmed -> collected, plus cancelled.
  // (Legacy values in_prep/ready/completed tolerated on old rows.)
  status                   String       @default("new")
  src                      String       @default("direct") // direct | qr | instagram | referral
  referralCodeUsed         String?
  customerId               String?
  customer                 Customer?    @relation(fields: [customerId], references: [id])
  // Set once, atomically, the first time the order is marked completed — so the
  // review-request + referral notifications fire exactly once even if the status
  // is bounced out of and back into "completed".
  completedNotifiedAt      DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([locationId, collectionOrDeliveryDate])
  @@index([status])
  @@index([src])
  @@index([type])
  @@index([isSubscription])
}

// A board line on a v2 order (signature/gallery board × quantity). unitPrice is a
// snapshot of the board's price at order time so later admin price edits don't rewrite history.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  platterId String
  platter   Platter  @relation(fields: [platterId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// An add-on line on a v2 order. name + unitPrice are snapshots (add-ons can be renamed/deleted).
model OrderAddOn {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn    @relation(fields: [addOnId], references: [id])
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String
  referralCode String   @unique // the customer's own code to share
  lastOrderId  String?
  isBigSpender Boolean  @default(false) // manual admin tag
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // admin (staff). Customers do not log in.
  createdAt    DateTime @default(now())
}

model Referral {
  id        String   @id @default(cuid())
  code      String // the referrer's code that was redeemed
  orderId   String   @unique // the order that redeemed it
  discount  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([code])
}

model Setting {
  key   String @id // e.g. "firstOrderHook", "firstOrderHookText"
  value String
}
