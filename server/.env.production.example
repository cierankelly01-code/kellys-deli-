# Production environment for the API. Set these in your host (Vercel / Render) — NEVER commit real values.
NODE_ENV=production

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the direct/session string for migrations; the pooled string (?pgbouncer=true) for serverless runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Strong random secret — generate with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# The API REFUSES to start in production if this is missing, the dev default, or < 32 chars.
JWT_SECRET="REPLACE_WITH_64_HEX_CHARS"

PORT=4000

# The deployed customer-site origin(s), comma-separated. Used for CORS + referral links.
CLIENT_ORIGIN="https://your-app.vercel.app"

# Seed admin login. The seed REFUSES a weak/default password in production.
ADMIN_EMAIL="owner@kellysdeli.co.uk"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Image uploads -> Supabase Storage (required on serverless; falls back to local disk if unset).
# Create a PUBLIC bucket (default name "platter-images") in Supabase Storage.
# The service_role key is SECRET — set it in the host's env vars, never commit it.
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="platter-images"

# --- Stripe (live online payments) — OPTIONAL: the site runs without them ---
# Stripe Dashboard -> Developers -> API keys -> Secret key (sk_live_... ; sk_test_... to rehearse).
STRIPE_SECRET_KEY=""
# Stripe Dashboard -> Developers -> Webhooks -> Add endpoint:
#   URL:    https://www.kellysdeli.co.uk/api/payments/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded
# then copy its "Signing secret" (whsec_...). Payments still confirm without it (the
# customer's return to /confirm checks Stripe directly) — the webhook covers anyone who
# closes the tab before the redirect.
STRIPE_WEBHOOK_SECRET=""
# Public site URL used for Stripe's return links + email links. Defaults to the live site.
PUBLIC_URL="https://www.kellysdeli.co.uk"

# --- Database migrations on boot ---
# `npm start` runs `prisma migrate deploy` before starting. If DATABASE_URL is a pooled
# (pgbouncer) string, set DIRECT_URL to the direct :5432 string for migrations.
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
# SKIP_BOOT_MIGRATE=1   # turn the boot migration off
